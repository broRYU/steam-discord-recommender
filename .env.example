# Discordで作成したWebhook URLをローカル実行時だけ設定します。
# このファイルには実際のURLを書かず、.envへコピーして使用してください。
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

COUNTRY_CODE=JP
LANGUAGE=japanese
RECOMMENDATION_MODE=upcoming
MAX_PRICE_YEN=5000
MIN_DISCOUNT_PERCENT=0
POST_COUNT=1
ALLOW_FREE_GAMES=true
ALLOW_MATURE_GAMES=false
EXCLUDE_APP_IDS=

